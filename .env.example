# ABX works for installation, builds, tests, previews, public RPC reads, and browser-wallet signing
# with no environment variables. Copy only the OPTIONAL entries you need into `.env`; never commit
# that file. `pnpm abx doctor` shows the effective configuration without printing secrets.

# OPTIONAL - network and RPC overrides.
# The shipped default is Base Sepolia with public fallback RPCs.
# ABX_CHAIN=base-sepolia
# ABX_RPC_URLS_BASE_SEPOLIA=https://base-sepolia-rpc.publicnode.com,https://sepolia.base.org
# ABX_RPC_URLS_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
# ABX_RPC_URLS_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
# Arbitrum Sepolia is experimental qualification support with canonical ABX contracts deployed.
# Base production is beta. The public fallback is suitable for basic reads; for deliberate
# production work, use a dedicated provider endpoint. Arbitrum One and Ethereum remain disabled.
# ABX_RPC_URLS_BASE=https://YOUR_BASE_RPC
# ABX_RPC_URLS_ARBITRUM_ONE=https://YOUR_ARBITRUM_ONE_RPC
# ABX_RPC_URLS_ETHEREUM=https://YOUR_ETHEREUM_RPC

# OPTIONAL - unattended signing.
# `ABX_DEPLOYER_PK` may be used for testnet work or deliberate production automation. Use a
# dedicated, minimally funded key. Before a production transaction, state the network, signer,
# actions, value, irreversible effects, and paired-testnet evidence.
# ABX_DEPLOYER_PK=0xYOUR_DEDICATED_PRIVATE_KEY

# OPTIONAL - IPFS through Pinata. Without these, `--backend ipfs` uses local Kubo defaults.
# ABX_STORAGE_BACKEND=ipfs
# ABX_IPFS_MODE=pinata
# PINATA_JWT=YOUR_PINATA_JWT
# ABX_IPFS_GATEWAY=https://gateway.pinata.cloud

# OPTIONAL - S3-compatible cloud storage (AWS S3, Cloudflare R2, or compatible providers).
# ABX_STORAGE_BACKEND=cloud
# ABX_S3_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
# ABX_S3_BUCKET=YOUR_BUCKET
# ABX_S3_REGION=auto
# ABX_S3_PREFIX=abx/content/
# ABX_S3_PUBLIC_BASE=https://assets.example.com
# ABX_S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# ABX_S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# OPTIONAL - Arweave customization.
# Some small Turbo uploads may not require prepaid credit; check current provider terms. ABX creates
# a managed key when needed.
# ABX_ARWEAVE_GATEWAY=https://arweave.net
# ABX_STORAGE_SIGNER=arweave

# OPTIONAL - a self-hosted resolver and effects runner.
# Generate strong, unrelated random values for the admin and effects tokens.
# ABX_PUBLIC_BASE_URL=https://metadata.example.com
# ABX_RESOLVER_ADMIN_TOKEN=YOUR_RESOLVER_ADMIN_TOKEN
# ABX_EFFECTS_URL=https://effects.example.com
# ABX_EFFECTS_TOKEN=YOUR_EFFECTS_TOKEN
# ABX_REMOTE_SELF_TOKEN=YOUR_RESOLVER_ADMIN_TOKEN

# OPTIONAL - a named third-party resolver. Replace MYPROVIDER consistently in both variable names.
# ABX_REMOTE_MYPROVIDER_URL=https://metadata.provider.example
# ABX_REMOTE_MYPROVIDER_TOKEN=YOUR_PROVIDER_TOKEN

# OPTIONAL - marketplace refresh integration.
# OPENSEA_API_KEY=YOUR_OPENSEA_API_KEY

# `abx auth login` manages ABX_SERVICES_API_KEY in ignored `.env`; do not add it to this template.
# Advanced timing, deployment-address, generated mint-page, and test-only variables live in the docs
# or generated artifacts rather than this contributor template.
