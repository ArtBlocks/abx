{
  "name": "@artblocks/abx-cli",
  "version": "0.1.0-alpha.45",
  "license": "MIT",
  "description": "Command-line interface for deploying, operating, indexing, and serving ABX projects.",
  "type": "module",
  "main": "./src/main.ts",
  "exports": {
    ".": "./src/main.ts"
  },
  "files": [
    "dist",
    "skill",
    "assets",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtBlocks/abx.git",
    "directory": "packages/cli"
  },
  "homepage": "https://docs.abx.io",
  "bugs": "https://github.com/ArtBlocks/abx/issues",
  "keywords": [
    "abx",
    "nft",
    "cli",
    "erc721",
    "ethereum",
    "art-blocks",
    "self-host"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/main.js",
    "bin": {
      "abx": "./dist/bin.js"
    },
    "exports": {
      ".": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "tsc -b tsconfig.build.json && node scripts/bundle-skill.mjs"
  },
  "dependencies": {
    "@artblocks/abx-sdk": "workspace:*",
    "@artblocks/abx-indexer": "workspace:*",
    "@artblocks/abx-storage": "workspace:*",
    "@artblocks/abx-token-api": "workspace:*",
    "viem": "^2.56.3"
  },
  "optionalDependencies": {
    "@artblocks/abx-effects": "workspace:*"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
