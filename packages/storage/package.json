{
  "name": "@artblocks/abx-storage",
  "version": "0.1.0-alpha.35",
  "license": "MIT",
  "description": "Storage adapters for ABX content using filesystem, S3-compatible, IPFS, or Arweave backends.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtBlocks/abx.git",
    "directory": "packages/storage"
  },
  "homepage": "https://docs.abx.io",
  "bugs": "https://github.com/ArtBlocks/abx/issues",
  "keywords": [
    "abx",
    "nft",
    "storage",
    "ipfs",
    "arweave",
    "art-blocks"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@artblocks/abx-sdk": "workspace:*",
    "viem": "^2.56.3"
  },
  "peerDependencies": {
    "@artblocks/abx-storage-arweave": ">=0.1.0-alpha.0"
  },
  "peerDependenciesMeta": {
    "@artblocks/abx-storage-arweave": {
      "optional": true
    }
  },
  "devDependencies": {
    "@artblocks/abx-storage-arweave": "workspace:*"
  }
}
